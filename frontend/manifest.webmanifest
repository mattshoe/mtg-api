{
  "name": "MTG Collection",
  "short_name": "Collection",
  "id": "/mtg-collection-2",
  "start_url": "./#/search",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/*",
            "application/octet-stream",
            "application/csv",
            "application/vnd.ms-excel",
            "application/json",
            "text/plain",
            "text/csv",
            "*/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "open",
      "accept": {
        "text/plain": [
          ".txt",
          ".dek",
          ".dec",
          ".cod",
          ".mwdeck",
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ]
}
