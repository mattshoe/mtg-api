<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 and up refuse to show a notification until the person
         has said yes, and refuse silently. Asking is MainActivity's job;
         this only makes asking possible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:name=".Images" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- The whole app. The same screens the website has. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A link to the site opens the app on the same thing the
                 browser would have shown. `autoVerify` is what makes it
                 open without a chooser, and it only holds while
                 https://mtg.mattshoe.org/.well-known/assetlinks.json
                 names this package and this signing certificate — see
                 frontend/.well-known/assetlinks.json.

                 Both hosts, because a link that has been through a
                 messaging app comes back with whatever `www.` the
                 sender's keyboard added. No path filter: the site is
                 hash-routed, the fragment never reaches the filter, so
                 every address on the host is this app's. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mtg.mattshoe.org" />
                <data android:scheme="https" android:host="www.mtg.mattshoe.org" />
                <data android:scheme="http" android:host="mtg.mattshoe.org" />
                <data android:scheme="http" android:host="www.mtg.mattshoe.org" />
            </intent-filter>
            <!-- What the share button hands out: the Worker's preview page,
                 so a pasted link previews as the deck in Discord. Only
                 under /s/, because the rest of that host is the API. The
                 Worker serves the same assetlinks.json as the site. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mtg-api.mattshoe81.workers.dev" />
                <data android:pathPrefix="/s/" />
            </intent-filter>
            <!-- A share from another app opens the whole app, in its own
                 task, with the list in the entry box. It used to open a
                 second activity that drew the wizard alone, inside the
                 sharing app's task, with nothing behind "New deck" or
                 "Upload a file". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Firebase hands the new token to this when it rotates, which
             it does on a reinstall, a restore, and sometimes nothing
             visible at all. Without it a phone goes quiet weeks later
             and nothing says why. -->
        <service android:name=".Push" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- What a notification looks like when the app is not open.
             Without these Android uses the app icon at full bleed, which
             on a white launcher icon is a white square. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tasks" />
    </application>
</manifest>
