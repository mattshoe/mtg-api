<?xml version="1.0" encoding="utf-8"?>
<!--
  The lotus, as the launcher draws it.

  The artwork is a complete rounded tile with its own dark field, so
  it cannot be the foreground as it stands: the launcher masks the
  foreground again, which would round the corners twice and cut into
  the mana dots. The foreground here is the same art scaled into the
  inner two thirds — the only part of an adaptive icon guaranteed to
  survive every mask — over a background in the artwork's own colour,
  so the two layers meet invisibly.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
