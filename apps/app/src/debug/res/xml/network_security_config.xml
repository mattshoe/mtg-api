<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The instrumentation tests stand up a stub server on
  the loopback interface so the API client can be exercised on-device with
  no network and no credentials; cleartext to anywhere else stays refused,
  and the release build has no config at all, so it is HTTPS only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
